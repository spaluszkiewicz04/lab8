<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab8.MainWindow"
        Title="Kasyno Online" Width="400" Height="450">

    <StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Button Name="BtnAddPlayer" Content="Dodaj Gracza" Width="200" HorizontalContentAlignment="Center"/>
        <Button Name="BtnHistory" Content="Historia Rozgrywek" Width="200" HorizontalContentAlignment="Center"/>

        <Border Height="2" Background="Gray" Margin="0, 10"/>

        <Button Name="BtnGame1" Content="Makao" Width="200" HorizontalContentAlignment="Center"/>
        <Button Name="BtnGame2" Content="Gra 2" Width="200" HorizontalContentAlignment="Center"/>
        <Button Name="BtnGame3" Content="Gra 3" Width="200" HorizontalContentAlignment="Center"/>
    </StackPanel>
</Window>