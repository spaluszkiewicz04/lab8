<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab8.PanWindow"
        Title="Pan" Width="700" Height="500">

    <Grid>
        <StackPanel Name="PanelCover" IsVisible="True" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Name="TxtCoverMessage" Text="Teraz gra: Gracz" FontSize="24" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Center"/>
            <Button Name="BtnReady" Content="Jestem gotowy, pokaż karty" FontSize="18" Padding="15" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Name="PanelGame" IsVisible="False" RowDefinitions="Auto, *, 200" Margin="20">

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <TextBlock Name="TxtOpponentsInfo" Text="Przeciwnicy: ..." FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Karta na stosie:" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Name="TxtTopCard" Text="-" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="TxtStackCount" Text="Karty na stosie: 0" FontStyle="Italic" HorizontalAlignment="Center"/>
                <Button Name="BtnTakeCards" Content="Dobierz karty" Width="150" HorizontalContentAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Name="TxtCurrentPlayerCards" Text="Twoje karty:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox Name="LstCurrentHand" Height="150">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15,10" Margin="5" Background="White">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

        </Grid>
    </Grid>
</Window>