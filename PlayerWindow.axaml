<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab8.PlayerWindow"
        Title="Dodaj Gracza" Width="300" Height="200">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Login:" />
        <TextBox Name="TxtLogin" Watermark="asiabasiacasia" />
        <TextBlock Name="TxtMessage" Foreground="Green" />
        <Button Name="BtnSave" Content="Dodaj" Width="60" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>